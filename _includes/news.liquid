<div class="news">
  {% if site.news != blank %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = site.news | size %}
        {% endif %}
        {% assign displayed_news = 0 %}
        {% assign one_year_ago = site.time | date: '%s' | minus: 31536000 %}
        {% for item in news %}
          {% assign item_timestamp = item.date | date: '%s' | plus: 0 %}
          {% if include.limit and item_timestamp < one_year_ago %}
            {% continue %}
          {% endif %}
          {% if displayed_news >= news_limit %}
            {% break %}
          {% endif %}
          <tr>
            <th scope="row" class="type-meta" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td class="type-body">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
          {% assign displayed_news = displayed_news | plus: 1 %}
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
