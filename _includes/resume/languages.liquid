<table class="language-table">
  <thead>
    <tr>
      {% for content in data[1] %}
        <th scope="col" class="type-item-title type-item-title--accent">{{ content.language }}</th>
      {% endfor %}
    </tr>
  </thead>
  <tbody>
    <tr>
      {% for content in data[1] %}
        <td class="type-body">{{ content.fluency }}</td>
      {% endfor %}
    </tr>
  </tbody>
</table>
