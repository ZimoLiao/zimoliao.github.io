<table class="language-table">
  <thead>
    <tr>
      {% for content in data[1] %}
        <th scope="col">{{ content.language }}</th>
      {% endfor %}
    </tr>
  </thead>
  <tbody>
    <tr>
      {% for content in data[1] %}
        <td>{{ content.fluency }}</td>
      {% endfor %}
    </tr>
  </tbody>
</table>
