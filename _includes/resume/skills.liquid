<div class="skill-groups">
  {% for content in data[1] %}
    <div class="skill-group" title="{{ content.level }}">
      <div class="skill-group-category">
        {% if content.icon %}
          <i class="{{ content.icon }}"></i>
        {% endif %}
        <span>{{ content.name }}</span>
      </div>
      <ul class="skill-group-items">
        {% for item in content.keywords %}
          <li>
            {{ item -}}
            {%- unless forloop.last %};{% endunless %}
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endfor %}
</div>
